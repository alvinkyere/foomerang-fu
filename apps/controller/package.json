{
  "name": "@foomerang/controller",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The phone controller: a Vite + React app that renders whatever controller the game's manifest describes.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview --host",
    "dev:host": "tsx dev/dev-host.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@foomerang/config": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@foomerang/controller-sdk": "workspace:*",
    "@foomerang/protocol": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
