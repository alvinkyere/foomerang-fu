{
  "name": "@foomerang/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The host display: lobby with QR, the primitive arena (Phaser rendering game-core state), and an engineering debug overlay.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview --host",
    "serve:tv": "node scripts/serve-tv.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@foomerang/config": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@foomerang/controller-sdk": "workspace:*",
    "@foomerang/foomerang-fu": "workspace:*",
    "@foomerang/game-core": "workspace:*",
    "@foomerang/protocol": "workspace:*",
    "phaser": "4.2.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.185.1"
  }
}
