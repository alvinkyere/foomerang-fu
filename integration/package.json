{
  "name": "@foomerang/integration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Test-only workspace: exercises the real packages together over real sockets, and the real console and controller in a real browser (Playwright). Nothing may depend on it.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:tls": "FOOMERANG_E2E_TLS=1 playwright test -c e2e/playwright.config.ts",
    "e2e:webkit": "FOOMERANG_E2E_WEBKIT=1 playwright test -c e2e/playwright.config.ts e2e/webkit.e2e.ts"
  },
  "devDependencies": {
    "@foomerang/config": "workspace:*",
    "@foomerang/controller-sdk": "workspace:*",
    "@foomerang/protocol": "workspace:*",
    "@foomerang/server": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
