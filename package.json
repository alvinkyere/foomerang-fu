{
  "name": "foomerang",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm e2e",
    "build": "turbo run build",
    "e2e": "pnpm --filter @foomerang/integration e2e",
    "dev:demo": "node scripts/dev.mjs",
    "e2e:tls": "pnpm --filter @foomerang/integration e2e:tls",
    "e2e:webkit": "pnpm --filter @foomerang/integration e2e:webkit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
